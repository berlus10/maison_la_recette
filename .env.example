# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais commiter .env.local.

# Resend : envoi des e-mails (devis et contact). Clé créée sur resend.com > API Keys.
RESEND_API_KEY=

# Adresse qui reçoit les demandes de devis et les messages de contact.
# Pendant les tests, sans domaine vérifié dans Resend, mettre l'adresse du compte Resend.
CONTACT_TO_EMAIL=

# Expéditeur des e-mails. Garder onboarding@resend.dev tant que le domaine
# de la cliente n'est pas vérifié dans Resend.
EMAIL_FROM=Maison La Recette <onboarding@resend.dev>

# Flux RSS du podcast (Ausha). Sans lui, le site utilise le snapshot enregistré.
PODCAST_RSS_URL=
